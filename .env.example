# Optional settings for the local web app. Editing and export work without this file.
# To configure a service, copy this file to .env.local and fill in only its settings.
# Never commit .env.local.

# Anthropic (script generation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Voice (TTS). Provider: fishaudio | elevenlabs.
# If unset: fishaudio when FISH_AUDIO_API_KEY is set, otherwise elevenlabs.
TTS_PROVIDER=
# Optional: voice preselected for new projects (an id of the active provider)
TTS_DEFAULT_VOICE_ID=

# Fish Audio (https://fish.audio/app/api-keys)
FISH_AUDIO_API_KEY=
# s2.1-pro (default, paid per byte) | s2.1-pro-free (free, for testing) | s2-pro | drama-3
FISH_AUDIO_MODEL=s2.1-pro
# Optional BCP-47 tag for number normalization and word timestamps. Defaults to the app language.
FISH_AUDIO_LANGUAGE=

# ElevenLabs (alternative provider)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# B-roll: stock video and images from Pixabay (https://pixabay.com/api/docs/).
# Optional: without it scenes use the animated gradient background.
PIXABAY_API_KEY=

# Where the SQLite DB, TTS cache, builds and MP4s live (absolute or relative to this repo)
STORAGE_DIR=./storage
