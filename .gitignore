# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local credentials and private keys
.git-credentials
.netrc
_netrc
.npmrc
.pypirc
id_rsa
id_ecdsa
id_ed25519
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# misc
.DS_Store

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment files and the public template
.env*
!/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data: SQLite DB, TTS cache, builds and renders
/storage/
app.db
app.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Local reference archives and tool state
/.local/
/.claude/settings.local.json
/.claude/worktrees/

# .claude/skills/* are Windows junctions to .agents/skills/* (created by the skills
# installer from skills-lock.json); committing them would duplicate every file.
/.claude/skills/

# Generated desktop runtimes, downloads and Rust output
/.desktop/
/src-tauri/target/
/src-tauri/gen/
/src-tauri/resources/
/src-tauri/binaries/
